{
  "name": "vscode-eslint-protected",
  "displayName": "vscode-eslint-protected",
  "description": "Automatically write @protected comments for eslint-protection",
  "version": "0.0.1",
  "publisher": "CrabNebula",
  "main": "./dist/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crabnebula-dev/vscode-eslint-protected.git"
  },
  "icon": "eslint-protection-logo.png",
  "galleryBanner": {
    "color": "#051024",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "keywords": [
    "Eslint",
    "Protection",
    "Comments"
  ],
  "author": "Alex Lohr <alex@crabnebula.dev>",
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/crabnebula-dev/vscode-eslint-protected/issues"
  },
  "homepage": "https://github.com/crabnebula-dev/vscode-eslint-protected#readme",
  "contributes": {
    "commands": [
      {
        "command": "eslint-protect.selected",
        "title": "Add protection comment to selected code (or line w/o selection)"
      },
      {
        "command": "eslint-protect.file",
        "title": "Add protection comment to whole file"
      }
    ],
    "keybindings": [
      {
        "command": "eslint-protect.selected",
        "key": "ctrl+alt+l",
        "mac": "ctrl+cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "eslint-protect.file",
        "key": "shift+ctrl+alt+l",
        "mac": "shift+ctrl+cmd+l",
        "when": "editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.99.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "esbuild": "^0.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.3.2"
  }
}
